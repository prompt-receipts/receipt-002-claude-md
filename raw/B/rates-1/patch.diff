diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/app/features/rates.py b/app/features/rates.py
--- a/app/features/rates.py	1969-12-31 17:00:00.000000000 -0700
+++ b/app/features/rates.py	2026-11-07 12:15:39.408692515 -0700
@@ -0,0 +1,23 @@
+"""Currency rates."""
+import re
+
+from app.errors import AppError, ValidationError
+from app.http import get_json
+
+RATES_URL = "https://api.example.test/rates/{}"
+_CURRENCY_RE = re.compile(r"[A-Z]{3}")
+
+
+def fetch_rate(currency):
+    """Return the cents_per_unit rate for a three-letter uppercase currency code.
+
+    Raises ValidationError without making a request if the code is malformed.
+    """
+    if not isinstance(currency, str) or _CURRENCY_RE.fullmatch(currency) is None:
+        raise ValidationError("currency must be exactly three uppercase letters")
+
+    body = get_json(RATES_URL.format(currency))
+    cents = body.get("cents_per_unit") if isinstance(body, dict) else None
+    if not isinstance(cents, int) or isinstance(cents, bool):
+        raise AppError("rate response missing integer cents_per_unit")
+    return cents
diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/tests/test_rates.py b/tests/test_rates.py
--- a/tests/test_rates.py	1969-12-31 17:00:00.000000000 -0700
+++ b/tests/test_rates.py	2026-11-07 12:15:41.923610098 -0700
@@ -0,0 +1,35 @@
+import pytest
+
+from app.errors import AppError, ValidationError
+from app.features import rates
+from app.features.rates import fetch_rate
+
+
+@pytest.fixture
+def calls(monkeypatch):
+    seen = []
+
+    def fake_get_json(url):
+        seen.append(url)
+        return {"cents_per_unit": 92}
+
+    monkeypatch.setattr(rates, "get_json", fake_get_json)
+    return seen
+
+
+def test_fetch_rate_returns_cents_and_requests_url(calls):
+    assert fetch_rate("EUR") == 92
+    assert calls == ["https://api.example.test/rates/EUR"]
+
+
+@pytest.mark.parametrize("bad", ["eur", "EU", "EURO", "EU1", "EU ", " EUR", "EUR\n", "", None, 123])
+def test_invalid_currency_raises_without_request(calls, bad):
+    with pytest.raises(ValidationError):
+        fetch_rate(bad)
+    assert calls == []
+
+
+def test_missing_rate_field_raises_app_error(monkeypatch):
+    monkeypatch.setattr(rates, "get_json", lambda url: {"other": 1})
+    with pytest.raises(AppError):
+        fetch_rate("USD")
