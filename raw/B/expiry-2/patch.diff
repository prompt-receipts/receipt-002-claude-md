diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/app/features/expiry.py b/app/features/expiry.py
--- a/app/features/expiry.py	1969-12-31 17:00:00.000000000 -0700
+++ b/app/features/expiry.py	2026-11-07 12:12:06.986651976 -0700
@@ -0,0 +1,27 @@
+"""Expiry checks for issued timestamps."""
+from datetime import datetime, timedelta
+
+from app.clock import now
+from app.errors import ValidationError
+
+
+def is_expired(issued_iso, ttl_seconds):
+    """Return True if issued time + ttl_seconds is at or before the current time.
+
+    issued_iso must be an ISO-8601 timestamp with a UTC offset,
+    e.g. "2024-05-01T12:00:00+00:00".
+    """
+    try:
+        issued = datetime.fromisoformat(issued_iso)
+    except (TypeError, ValueError) as exc:
+        raise ValidationError(f"invalid ISO-8601 timestamp: {issued_iso!r}") from exc
+
+    if issued.tzinfo is None or issued.utcoffset() is None:
+        raise ValidationError(f"timestamp must include a UTC offset: {issued_iso!r}")
+
+    try:
+        expires_at = issued + timedelta(seconds=ttl_seconds)
+    except (TypeError, OverflowError) as exc:
+        raise ValidationError(f"invalid ttl_seconds: {ttl_seconds!r}") from exc
+
+    return expires_at <= now()
diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/tests/test_expiry.py b/tests/test_expiry.py
--- a/tests/test_expiry.py	1969-12-31 17:00:00.000000000 -0700
+++ b/tests/test_expiry.py	2026-11-07 12:12:09.372573832 -0700
@@ -0,0 +1,59 @@
+import pytest
+
+from app import clock
+from app.errors import ValidationError
+from app.features.expiry import is_expired
+from datetime import datetime, timezone
+
+
+@pytest.fixture(autouse=True)
+def _reset_clock():
+    yield
+    clock.set_now(None)
+
+
+def _at(iso):
+    clock.set_now(datetime.fromisoformat(iso).astimezone(timezone.utc))
+
+
+def test_not_expired_before_ttl():
+    _at("2024-05-01T12:00:59+00:00")
+    assert is_expired("2024-05-01T12:00:00+00:00", 60) is False
+
+
+def test_expired_exactly_at_ttl_boundary():
+    _at("2024-05-01T12:01:00+00:00")
+    assert is_expired("2024-05-01T12:00:00+00:00", 60) is True
+
+
+def test_expired_after_ttl():
+    _at("2024-05-01T13:00:00+00:00")
+    assert is_expired("2024-05-01T12:00:00+00:00", 60) is True
+
+
+def test_offset_is_respected():
+    # 12:00 at +02:00 is 10:00 UTC; 30 minutes later is 10:30 UTC.
+    _at("2024-05-01T10:29:59+00:00")
+    assert is_expired("2024-05-01T12:00:00+02:00", 30 * 60) is False
+    _at("2024-05-01T10:30:00+00:00")
+    assert is_expired("2024-05-01T12:00:00+02:00", 30 * 60) is True
+
+
+def test_zero_ttl_is_expired_immediately():
+    _at("2024-05-01T12:00:00+00:00")
+    assert is_expired("2024-05-01T12:00:00+00:00", 0) is True
+
+
+def test_naive_timestamp_rejected():
+    with pytest.raises(ValidationError):
+        is_expired("2024-05-01T12:00:00", 60)
+
+
+def test_garbage_timestamp_rejected():
+    with pytest.raises(ValidationError):
+        is_expired("not a time", 60)
+
+
+def test_bad_ttl_rejected():
+    with pytest.raises(ValidationError):
+        is_expired("2024-05-01T12:00:00+00:00", "60")
