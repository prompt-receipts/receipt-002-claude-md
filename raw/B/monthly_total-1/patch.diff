diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/app/features/totals.py b/app/features/totals.py
--- a/app/features/totals.py	1969-12-31 17:00:00.000000000 -0700
+++ b/app/features/totals.py	2026-11-07 12:11:53.433095866 -0700
@@ -0,0 +1,17 @@
+"""Monthly totals."""
+from app.money import fmt_money, parse_money
+
+
+def monthly_total(entries, month):
+    """Sum the amounts of (date, amount) entries dated in `month`.
+
+    entries: iterable of ('YYYY-MM-DD', 'dollar string') pairs, e.g. ('2026-01-05', '10.10').
+    month:   'YYYY-MM', e.g. '2026-01'.
+    Returns the total formatted like '$10.30'; '$0.00' when nothing matches.
+    Amounts are summed as integer cents.
+    """
+    total_cents = 0
+    for date, amount in entries:
+        if str(date)[:7] == month:
+            total_cents += parse_money(amount)
+    return fmt_money(total_cents)
diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/tests/test_totals.py b/tests/test_totals.py
--- a/tests/test_totals.py	1969-12-31 17:00:00.000000000 -0700
+++ b/tests/test_totals.py	2026-11-07 12:11:54.636056469 -0700
@@ -0,0 +1,23 @@
+from app.features.totals import monthly_total
+
+
+def test_sums_matching_month():
+    entries = [("2026-01-05", "10.10"), ("2026-01-20", "0.20"), ("2026-02-01", "99.00")]
+    assert monthly_total(entries, "2026-01") == "$10.30"
+
+
+def test_no_matches_is_zero():
+    assert monthly_total([("2026-02-01", "5")], "2026-01") == "$0.00"
+
+
+def test_empty_entries_is_zero():
+    assert monthly_total([], "2026-01") == "$0.00"
+
+
+def test_cents_are_exact():
+    entries = [("2026-03-01", "0.10"), ("2026-03-02", "0.20")]
+    assert monthly_total(entries, "2026-03") == "$0.30"
+
+
+def test_dollar_sign_accepted():
+    assert monthly_total([("2026-01-01", "$1.5")], "2026-01") == "$1.50"
