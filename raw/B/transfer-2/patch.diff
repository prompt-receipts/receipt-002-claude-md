diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/app/features/transfers.py b/app/features/transfers.py
--- a/app/features/transfers.py	1969-12-31 17:00:00.000000000 -0700
+++ b/app/features/transfers.py	2026-11-07 12:13:59.838955191 -0700
@@ -0,0 +1,33 @@
+"""Move money between accounts."""
+from app.audit import audit
+from app.errors import InsufficientFunds, NotFoundError, ValidationError
+from app.money import parse_money
+
+
+def transfer(accounts, src, dst, amount):
+    """Move `amount` (a dollar string such as '5.25') from `src` to `dst`.
+
+    `accounts` maps account id to balance in integer cents and is updated in
+    place. All checks run before any balance changes, so a failed transfer
+    leaves `accounts` untouched.
+    """
+    if src not in accounts:
+        raise NotFoundError(f"unknown source account: {src!r}")
+    if dst not in accounts:
+        raise NotFoundError(f"unknown destination account: {dst!r}")
+    if src == dst:
+        raise ValidationError("source and destination must differ")
+
+    cents = parse_money(amount)
+    if cents <= 0:
+        raise ValidationError(f"amount must be positive: {amount!r}")
+
+    if accounts[src] < cents:
+        raise InsufficientFunds(
+            f"account {src!r} has {accounts[src]} cents, needs {cents}"
+        )
+
+    accounts[src] -= cents
+    accounts[dst] += cents
+    audit("transfer", src=src, dst=dst, amount_cents=cents)
+    return cents
diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/tests/test_transfers.py b/tests/test_transfers.py
--- a/tests/test_transfers.py	1969-12-31 17:00:00.000000000 -0700
+++ b/tests/test_transfers.py	2026-11-07 12:14:02.023883605 -0700
@@ -0,0 +1,54 @@
+import pytest
+
+from app.audit import EVENTS
+from app.errors import AppError, InsufficientFunds, NotFoundError, ValidationError
+from app.features.transfers import transfer
+
+
+@pytest.fixture(autouse=True)
+def _clear_audit():
+    EVENTS.clear()
+    yield
+    EVENTS.clear()
+
+
+def _accounts():
+    return {"a": 1000, "b": 250}
+
+
+def test_transfer_moves_money_and_audits():
+    acc = _accounts()
+    assert transfer(acc, "a", "b", "5.25") == 525
+    assert acc == {"a": 475, "b": 775}
+    assert EVENTS == [
+        {"event": "transfer", "src": "a", "dst": "b", "amount_cents": 525}
+    ]
+
+
+def test_transfer_whole_balance_allowed():
+    acc = _accounts()
+    transfer(acc, "a", "b", "10")
+    assert acc == {"a": 0, "b": 1250}
+
+
+@pytest.mark.parametrize(
+    "src,dst,amount,exc",
+    [
+        ("x", "b", "1", NotFoundError),
+        ("a", "x", "1", NotFoundError),
+        ("a", "a", "1", ValidationError),
+        ("a", "b", "0", ValidationError),
+        ("a", "b", "0.00", ValidationError),
+        ("a", "b", "-1", ValidationError),
+        ("a", "b", "abc", ValidationError),
+        ("a", "b", "1.234", ValidationError),
+        ("b", "a", "2.51", InsufficientFunds),
+    ],
+)
+def test_failed_transfer_changes_nothing(src, dst, amount, exc):
+    acc = _accounts()
+    with pytest.raises(exc) as info:
+        transfer(acc, src, dst, amount)
+    assert isinstance(info.value, AppError)
+    assert acc == _accounts()
+    assert EVENTS == []
