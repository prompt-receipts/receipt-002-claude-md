diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/app/features/accounts.py b/app/features/accounts.py
--- a/app/features/accounts.py	1969-12-31 17:00:00.000000000 -0700
+++ b/app/features/accounts.py	2026-11-07 12:19:26.985232698 -0700
@@ -0,0 +1,16 @@
+"""Account features."""
+from app.audit import audit
+from app.errors import NotFoundError
+
+
+def close_account(accounts, account_id):
+    """Close an account: remove it from `accounts` (id -> balance in cents).
+
+    Returns the balance the account had. Raises NotFoundError, leaving the
+    dict unchanged, if the account does not exist. Records an audit event.
+    """
+    if account_id not in accounts:
+        raise NotFoundError(f"no such account: {account_id!r}")
+    balance = accounts.pop(account_id)
+    audit("account_closed", account_id=account_id, balance_cents=balance)
+    return balance
diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/tests/test_accounts.py b/tests/test_accounts.py
--- a/tests/test_accounts.py	1969-12-31 17:00:00.000000000 -0700
+++ b/tests/test_accounts.py	2026-11-07 12:19:28.330188602 -0700
@@ -0,0 +1,34 @@
+import pytest
+
+from app import audit as audit_mod
+from app.errors import NotFoundError
+from app.features.accounts import close_account
+
+
+@pytest.fixture(autouse=True)
+def _clear_audit():
+    audit_mod.EVENTS.clear()
+    yield
+    audit_mod.EVENTS.clear()
+
+
+def test_close_account_returns_balance_and_removes_it():
+    accounts = {"a1": 1250, "a2": 0}
+    assert close_account(accounts, "a1") == 1250
+    assert accounts == {"a2": 0}
+
+
+def test_close_account_records_audit_event():
+    accounts = {"a1": 1250}
+    close_account(accounts, "a1")
+    assert audit_mod.EVENTS == [
+        {"event": "account_closed", "account_id": "a1", "balance_cents": 1250}
+    ]
+
+
+def test_close_missing_account_raises_and_leaves_dict_unchanged():
+    accounts = {"a1": 500}
+    with pytest.raises(NotFoundError):
+        close_account(accounts, "nope")
+    assert accounts == {"a1": 500}
+    assert audit_mod.EVENTS == []
