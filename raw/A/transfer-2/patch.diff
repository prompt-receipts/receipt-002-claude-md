diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/app/features/transfers.py b/app/features/transfers.py
--- a/app/features/transfers.py	1969-12-31 17:00:00.000000000 -0700
+++ b/app/features/transfers.py	2026-11-07 12:11:05.147677072 -0700
@@ -0,0 +1,31 @@
+"""Move money between accounts."""
+from app.audit import audit
+from app.errors import InsufficientFunds, NotFoundError, ValidationError
+from app.money import parse_money
+
+
+def transfer(accounts, src, dst, amount):
+    """Move `amount` (a dollar string such as '5.25') from `src` to `dst`.
+
+    `accounts` maps account id -> balance in integer cents and is updated in
+    place. All checks run before any balance changes, so on error nothing is
+    modified. Raises NotFoundError, ValidationError or InsufficientFunds.
+    """
+    if src not in accounts:
+        raise NotFoundError(f"unknown account: {src!r}")
+    if dst not in accounts:
+        raise NotFoundError(f"unknown account: {dst!r}")
+    if src == dst:
+        raise ValidationError("source and destination must differ")
+
+    cents = parse_money(amount)
+    if cents <= 0:
+        raise ValidationError(f"amount must be positive: {amount!r}")
+
+    if accounts[src] < cents:
+        raise InsufficientFunds(f"account {src!r} has insufficient funds")
+
+    accounts[src] -= cents
+    accounts[dst] += cents
+    audit("transfer", src=src, dst=dst, amount_cents=cents)
+    return cents
diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/tests/test_transfers.py b/tests/test_transfers.py
--- a/tests/test_transfers.py	1969-12-31 17:00:00.000000000 -0700
+++ b/tests/test_transfers.py	2026-11-07 12:11:07.865588075 -0700
@@ -0,0 +1,65 @@
+import pytest
+
+from app import audit as audit_mod
+from app.errors import InsufficientFunds, NotFoundError, ValidationError
+from app.features.transfers import transfer
+
+
+@pytest.fixture(autouse=True)
+def _clear_audit():
+    audit_mod.EVENTS.clear()
+    yield
+    audit_mod.EVENTS.clear()
+
+
+def _accounts():
+    return {"a": 1000, "b": 250}
+
+
+def test_transfer_moves_money_and_records_it():
+    accts = _accounts()
+    assert transfer(accts, "a", "b", "5.25") == 525
+    assert accts == {"a": 475, "b": 775}
+    assert audit_mod.EVENTS == [
+        {"event": "transfer", "src": "a", "dst": "b", "amount_cents": 525}
+    ]
+
+
+def test_transfer_full_balance_allowed():
+    accts = _accounts()
+    transfer(accts, "a", "b", "10")
+    assert accts == {"a": 0, "b": 1250}
+
+
+@pytest.mark.parametrize("src,dst", [("x", "b"), ("a", "x"), ("x", "y")])
+def test_unknown_account_raises_and_changes_nothing(src, dst):
+    accts = _accounts()
+    with pytest.raises(NotFoundError):
+        transfer(accts, src, dst, "1.00")
+    assert accts == _accounts()
+    assert audit_mod.EVENTS == []
+
+
+def test_same_account_raises_and_changes_nothing():
+    accts = _accounts()
+    with pytest.raises(ValidationError):
+        transfer(accts, "a", "a", "1.00")
+    assert accts == _accounts()
+    assert audit_mod.EVENTS == []
+
+
+@pytest.mark.parametrize("amount", ["0", "0.00", "-1.00", "abc", "", "1.234", "1.2.3"])
+def test_invalid_amount_raises_and_changes_nothing(amount):
+    accts = _accounts()
+    with pytest.raises(ValidationError):
+        transfer(accts, "a", "b", amount)
+    assert accts == _accounts()
+    assert audit_mod.EVENTS == []
+
+
+def test_insufficient_funds_raises_and_changes_nothing():
+    accts = _accounts()
+    with pytest.raises(InsufficientFunds):
+        transfer(accts, "b", "a", "2.51")
+    assert accts == _accounts()
+    assert audit_mod.EVENTS == []
