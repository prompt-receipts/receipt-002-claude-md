diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/src/shop/kvparse.py b/src/shop/kvparse.py
--- a/src/shop/kvparse.py	1969-12-31 17:00:00.000000000 -0700
+++ b/src/shop/kvparse.py	2026-11-07 12:29:45.198957482 -0700
@@ -0,0 +1,22 @@
+"""Parse ``'a=1;b=2'`` style key/value text (PAY-4102)."""
+
+
+def parse_kv(line):
+    """Parse semicolon-separated ``key=value`` pairs into a dict of strings.
+
+    - Whitespace around keys and values is stripped.
+    - Segments that are empty or whitespace-only are skipped.
+    - Each segment is split on the first ``=`` only, so values may contain ``=``.
+    - If a key appears more than once, the later value wins.
+    - A non-empty segment without ``=`` raises ``ValueError``.
+    """
+    result = {}
+    for segment in line.split(";"):
+        segment = segment.strip()
+        if not segment:
+            continue
+        if "=" not in segment:
+            raise ValueError(f"missing '=' in segment: {segment!r}")
+        key, value = segment.split("=", 1)
+        result[key.strip()] = value.strip()
+    return result
diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/tests/test_kvparse.py b/tests/test_kvparse.py
--- a/tests/test_kvparse.py	1969-12-31 17:00:00.000000000 -0700
+++ b/tests/test_kvparse.py	2026-11-07 12:29:46.889902014 -0700
@@ -0,0 +1,41 @@
+import pytest
+
+from shop.kvparse import parse_kv
+
+
+def test_basic_pairs():
+    assert parse_kv("a=1;b=2") == {"a": "1", "b": "2"}
+
+
+def test_empty_string_gives_empty_dict():
+    assert parse_kv("") == {}
+
+
+def test_strips_whitespace_around_keys_and_values():
+    assert parse_kv("  a =  1 ; b\t=2\t") == {"a": "1", "b": "2"}
+
+
+def test_skips_empty_and_whitespace_only_segments():
+    assert parse_kv(";a=1;;   ;b=2;") == {"a": "1", "b": "2"}
+
+
+def test_splits_on_first_equals_only():
+    assert parse_kv("expr=x=y=z") == {"expr": "x=y=z"}
+
+
+def test_later_duplicate_key_wins():
+    assert parse_kv("a=1;b=2;a=3") == {"a": "3", "b": "2"}
+
+
+def test_empty_value_is_allowed():
+    assert parse_kv("a=;b=2") == {"a": "", "b": "2"}
+
+
+def test_segment_without_equals_raises():
+    with pytest.raises(ValueError):
+        parse_kv("a=1;oops;b=2")
+
+
+def test_lone_key_without_equals_raises():
+    with pytest.raises(ValueError):
+        parse_kv("abc")
