@@ -0,0 +1,36 @@
+import pytest
+
+from shop.core import slugify, total
+
+
+def test_total_sums_prices():
+    assert total([1, 2, 3]) == 6
+
+
+@pytest.mark.parametrize(
+    "title, expected",
+    [
+        ("Hello World", "hello-world"),
+        ("  Leading and trailing  ", "leading-and-trailing"),
+        ("Multiple   spaces\t\tand\nnewlines", "multiple-spaces-and-newlines"),
+        ("a!!!b???c", "a-b-c"),
+        ("--already-dashed--", "already-dashed"),
+        ("Version 2.0 (beta)", "version-2-0-beta"),
+        ("Café Crème", "caf-cr-me"),
+        ("日本語", ""),
+        ("", ""),
+        ("!!!", ""),
+        ("ABC123", "abc123"),
+        ("snake_case_name", "snake-case-name"),
+    ],
+)
+def test_slugify(title, expected):
+    assert slugify(title) == expected
+
+
+def test_slugify_output_has_only_ascii_slug_characters():
+    result = slugify("Ünïcode, emoji 🎉 & symbols #1!")
+    assert result == "n-code-emoji-symbols-1"
+    assert set(result) <= set("abcdefghijklmnopqrstuvwxyz0123456789-")
+    assert not result.startswith("-") and not result.endswith("-")
+    assert "--" not in result
