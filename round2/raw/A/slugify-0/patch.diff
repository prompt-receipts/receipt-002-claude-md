+import re
+
+
 def total(prices):
     """Sum a list of prices."""
     return sum(prices)
+
+
+_NON_SLUG_CHARS = re.compile(r"[^a-z0-9]+")
+
+
+def slugify(title):
+    """Convert a title into a URL-friendly slug.
+
+    The text is lowercased, each run of characters that are not ASCII
+    letters or digits is replaced with a single '-', and leading and
+    trailing '-' are stripped.
+    """
+    return _NON_SLUG_CHARS.sub("-", title.lower()).strip("-")
