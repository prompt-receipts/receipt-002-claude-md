diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/src/shop/movavg.py b/src/shop/movavg.py
--- a/src/shop/movavg.py	1969-12-31 17:00:00.000000000 -0700
+++ b/src/shop/movavg.py	2026-11-07 12:34:22.946162600 -0700
@@ -0,0 +1,12 @@
+def moving_average(nums, k):
+    """Return the mean of every window of k consecutive numbers in nums.
+
+    The result has len(nums) - k + 1 floats, one per window, in order.
+    Raises ValueError if k < 1 or k > len(nums).
+    """
+    nums = list(nums)
+    if k < 1:
+        raise ValueError(f"k must be at least 1, got {k}")
+    if k > len(nums):
+        raise ValueError(f"k ({k}) must not exceed len(nums) ({len(nums)})")
+    return [float(sum(nums[i:i + k])) / k for i in range(len(nums) - k + 1)]
diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/tests/test_movavg.py b/tests/test_movavg.py
--- a/tests/test_movavg.py	1969-12-31 17:00:00.000000000 -0700
+++ b/tests/test_movavg.py	2026-11-07 12:34:24.660102842 -0700
@@ -0,0 +1,44 @@
+import pytest
+
+from shop.movavg import moving_average
+
+
+def test_basic_window():
+    assert moving_average([1, 2, 3, 4, 5], 3) == [2.0, 3.0, 4.0]
+
+
+def test_window_of_one_returns_floats():
+    assert moving_average([1, 2, 3], 1) == [1.0, 2.0, 3.0]
+    assert all(isinstance(x, float) for x in moving_average([1, 2, 3], 1))
+
+
+def test_window_equal_to_length():
+    assert moving_average([2, 4, 6], 3) == [4.0]
+
+
+def test_floats_input():
+    assert moving_average([0.5, 1.5, 2.5], 2) == [1.0, 2.0]
+
+
+def test_accepts_iterable():
+    assert moving_average(iter([1, 2, 3, 4]), 2) == [1.5, 2.5, 3.5]
+
+
+def test_empty_input_with_k_raises():
+    with pytest.raises(ValueError):
+        moving_average([], 1)
+
+
+def test_k_zero_raises():
+    with pytest.raises(ValueError):
+        moving_average([1, 2, 3], 0)
+
+
+def test_negative_k_raises():
+    with pytest.raises(ValueError):
+        moving_average([1, 2, 3], -2)
+
+
+def test_k_larger_than_length_raises():
+    with pytest.raises(ValueError):
+        moving_average([1, 2, 3], 4)
