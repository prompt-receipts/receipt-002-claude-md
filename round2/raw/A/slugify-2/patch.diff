+++ b/src/shop/slug.py	2026-11-07 12:39:23.162818934 -0700
@@ -0,0 +1,16 @@
+import re
+
+_NON_SLUG_CHARS = re.compile(r"[^a-z0-9]+")
+
+
+def slugify(title):
+    """Convert a title into a URL-friendly slug (PAY-4101).
+
+    The text is lowercased, every run of characters that are not ASCII
+    letters or digits is replaced with a single '-', and leading and
+    trailing '-' are stripped.
+
+    >>> slugify("Hello, World!")
+    'hello-world'
+    """
+    return _NON_SLUG_CHARS.sub("-", title.lower()).strip("-")
