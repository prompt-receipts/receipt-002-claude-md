--- a/tests/test_slugify.py	1969-12-31 17:00:00.000000000 -0700
+++ b/tests/test_slugify.py	2026-11-07 12:39:25.442741165 -0700
@@ -0,0 +1,33 @@
+import pytest
+
+from shop import slugify
+
+
+@pytest.mark.parametrize(
+    "title, expected",
+    [
+        ("Hello World", "hello-world"),
+        ("Hello, World!", "hello-world"),
+        ("  leading and trailing  ", "leading-and-trailing"),
+        ("---already-dashed---", "already-dashed"),
+        ("a   b\t\nc", "a-b-c"),
+        ("multiple---dashes", "multiple-dashes"),
+        ("Version 2.0 Release", "version-2-0-release"),
+        ("ABC123", "abc123"),
+        ("café au lait", "caf-au-lait"),
+        ("100% sure_thing", "100-sure-thing"),
+        ("", ""),
+        ("!!!", ""),
+        ("---", ""),
+    ],
+)
+def test_slugify(title, expected):
+    assert slugify(title) == expected
+
+
+def test_result_contains_only_ascii_alnum_and_single_dashes():
+    result = slugify("Ünïcödé ✓ --- Mixed!! 42")
+    assert result == "n-c-d-mixed-42"
+    assert all(c in "abcdefghijklmnopqrstuvwxyz0123456789-" for c in result)
+    assert "--" not in result
+    assert not result.startswith("-") and not result.endswith("-")
