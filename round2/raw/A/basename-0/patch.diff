@@ -0,0 +1,20 @@
+"""POSIX path helpers (PAY-4104)."""
+
+
+def basename_no_ext(path):
+    """Return the last path component of a POSIX path without its final extension.
+
+    A trailing slash is ignored. Leading dots are not treated as an extension,
+    so ``'.bashrc'`` stays ``'.bashrc'``; likewise ``'..'`` is returned unchanged.
+
+    >>> basename_no_ext('a/b/file.tar.gz')
+    'file.tar'
+    >>> basename_no_ext('dir/.bashrc')
+    '.bashrc'
+    """
+    name = path.rstrip("/").rsplit("/", 1)[-1]
+    body = name.lstrip(".")  # leading dots belong to the name, not an extension
+    idx = body.rfind(".")
+    if idx < 0:
+        return name
+    return name[: len(name) - len(body) + idx]
