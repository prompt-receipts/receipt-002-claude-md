+++ b/tests/test_pathnames.py	2026-11-07 12:30:08.633157946 -0700
@@ -0,0 +1,32 @@
+import pytest
+
+from shop.pathnames import basename_no_ext
+
+
+@pytest.mark.parametrize(
+    "path, expected",
+    [
+        ("a/b/file.tar.gz", "file.tar"),
+        ("file.txt", "file"),
+        ("/abs/path/report.pdf", "report"),
+        ("archive.tar.gz", "archive.tar"),
+        ("a/b/file.tar.gz/", "file.tar"),
+        ("a/b/file.txt//", "file"),
+        ("a/b/noext", "noext"),
+        ("noext", "noext"),
+        ("a/b/.bashrc", ".bashrc"),
+        (".bashrc", ".bashrc"),
+        (".bashrc.bak", ".bashrc"),
+        ("..", ".."),
+        ("...", "..."),
+        ("..foo", "..foo"),
+        (".a.b", ".a"),
+        ("dir.d/file", "file"),
+        ("dir.d/", "dir"),
+        ("file.", "file"),
+        ("/", ""),
+        ("", ""),
+    ],
+)
+def test_basename_no_ext(path, expected):
+    assert basename_no_ext(path) == expected
