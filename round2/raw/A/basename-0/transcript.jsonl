 extension.\n\n    A trailing slash is ignored. Leading dots are not treated as an extension,\n    so ``'.bashrc'`` stays ``'.bashrc'``; likewise ``'..'`` is returned unchanged.\n\n    >>> basename_no_ext('a/b/file.tar.gz')\n    'file.tar'\n    >>> basename_no_ext('dir/.bashrc')\n    '.bashrc'\n    \"\"\"\n    name = path.rstrip(\"/\").rsplit(\"/\", 1)[-1]\n    body = name.lstrip(\".\")  # leading dots belong to the name, not an extension\n    idx = body.rfind(\".\")\n    if idx < 0:\n        return name\n    return name[: len(name) - len(body) + idx]\n"}}}
