+++ b/tests/test_slugify.py	2026-11-07 12:39:41.782184088 -0700
@@ -0,0 +1,31 @@
+import pytest
+
+from shop.core import slugify
+
+
+@pytest.mark.parametrize(
+    "title, expected",
+    [
+        ("Hello World", "hello-world"),
+        ("  Hello,   World!  ", "hello-world"),
+        ("Already-a-slug", "already-a-slug"),
+        ("Python 3.12 Release", "python-3-12-release"),
+        ("a--b__c", "a-b-c"),
+        ("---edge---", "edge"),
+        ("Café Olé", "caf-ol"),
+        ("日本語", ""),
+        ("", ""),
+        ("!!!", ""),
+        ("ABC123", "abc123"),
+        ("tab\tnew\nline", "tab-new-line"),
+    ],
+)
+def test_slugify(title, expected):
+    assert slugify(title) == expected
+
+
+def test_result_has_no_leading_or_trailing_dash_and_no_double_dash():
+    result = slugify("  -- weird ** input -- ")
+    assert result == "weird-input"
+    assert not result.startswith("-") and not result.endswith("-")
+    assert "--" not in result
