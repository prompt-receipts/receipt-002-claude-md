+import re
+
+
 def total(prices):
     """Sum a list of prices."""
     return sum(prices)
+
+
+_NON_SLUG_CHARS = re.compile(r"[^a-z0-9]+")
+
+
+def slugify(title):
+    """Turn a title into a URL-friendly slug (PAY-4101).
+
+    Lowercases the text, replaces each run of characters that are not ASCII
+    letters or digits with a single '-', and strips leading/trailing '-'.
+    """
+    return _NON_SLUG_CHARS.sub("-", title.lower()).strip("-")
