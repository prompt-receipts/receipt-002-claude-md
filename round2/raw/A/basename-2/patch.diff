@@ -0,0 +1,23 @@
+"""POSIX path helpers (ticket PAY-4104)."""
+
+
+def basename_no_ext(path):
+    """Return the last path component of a POSIX path with its final extension removed.
+
+    A trailing slash is ignored. Leading dots are not treated as an extension
+    separator, so '.bashrc' stays '.bashrc' and '...' stays '...'.
+
+    Examples:
+        'a/b/file.tar.gz' -> 'file.tar'
+        'a/b/dir/'        -> 'dir'
+        'a/.bashrc'       -> '.bashrc'
+        'README'          -> 'README'
+    """
+    stripped = path.rstrip("/")
+    name = stripped.rsplit("/", 1)[-1]
+    # Skip the run of leading dots so they never count as an extension separator.
+    stem_start = len(name) - len(name.lstrip("."))
+    idx = name.rfind(".", stem_start)
+    if idx == -1:
+        return name
+    return name[:idx]
