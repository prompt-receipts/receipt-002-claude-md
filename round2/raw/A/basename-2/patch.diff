--- a/tests/test_pathnames.py	1969-12-31 17:00:00.000000000 -0700
+++ b/tests/test_pathnames.py	2026-11-07 12:38:54.513797014 -0700
@@ -0,0 +1,39 @@
+import pytest
+
+from shop.pathnames import basename_no_ext
+
+
+@pytest.mark.parametrize(
+    "path, expected",
+    [
+        ("a/b/file.tar.gz", "file.tar"),
+        ("file.txt", "file"),
+        ("/abs/path/report.pdf", "report"),
+        ("a/b/file", "file"),
+        ("README", "README"),
+        # trailing slash is ignored
+        ("a/b/dir/", "dir"),
+        ("a/b/file.tar.gz/", "file.tar"),
+        # repeated slashes
+        ("a//b///c.txt", "c"),
+        ("a/b//", "b"),
+        # leading dot is not an extension
+        (".bashrc", ".bashrc"),
+        ("a/.bashrc", ".bashrc"),
+        (".bashrc/", ".bashrc"),
+        (".tar.gz", ".tar"),
+        ("...", "..."),
+        ("..", ".."),
+        (".", "."),
+        # multiple dots: only the final extension is removed
+        ("archive.v1.2.zip", "archive.v1.2"),
+        # trailing dot yields an empty extension, which is stripped
+        ("file.", "file"),
+        ("a..", "a."),
+        # no component at all
+        ("", ""),
+        ("/", ""),
+    ],
+)
+def test_basename_no_ext(path, expected):
+    assert basename_no_ext(path) == expected
