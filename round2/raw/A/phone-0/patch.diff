@@ -0,0 +1,18 @@
+"""US phone number normalization (PAY-4107)."""
+
+
+def normalize_phone(text):
+    """Normalize a US phone number to E.164 form, e.g. '+15551234567'.
+
+    All non-digit characters are ignored. The remaining digits must be either
+    exactly 10 digits, or 11 digits starting with '1' (country code). Anything
+    else raises ValueError.
+    """
+    digits = "".join(ch for ch in text if ch in "0123456789")
+
+    if len(digits) == 11 and digits[0] == "1":
+        digits = digits[1:]
+    elif len(digits) != 10:
+        raise ValueError(f"not a US phone number: {text!r}")
+
+    return "+1" + digits
diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/tests/test_phones.py b/tests/test_phones.py
--- a/tests/test_phones.py	1969-12-31 17:00:00.000000000 -0700
+++ b/tests/test_phones.py	2026-11-07 12:28:36.746202938 -0700
@@ -0,0 +1,37 @@
+import pytest
+
+from shop.phones import normalize_phone
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("5551234567", "+15551234567"),
+        ("15551234567", "+15551234567"),
+        ("(555) 123-4567", "+15551234567"),
+        ("555-123-4567", "+15551234567"),
+        ("+1 (555) 123-4567", "+15551234567"),
+        ("1-555-123-4567", "+15551234567"),
+        ("555.123.4567", "+15551234567"),
+        ("  555 123 4567  ", "+15551234567"),
+    ],
+)
+def test_valid_numbers(text, expected):
+    assert normalize_phone(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "555-1234",  # 7 digits
+        "555123456",  # 9 digits
+        "55512345678",  # 11 digits, not starting with 1
+        "155512345678",  # 12 digits
+        "no digits here",
+        "+44 20 7946 0958",  # UK number, 12 digits
+    ],
+)
+def test_invalid_numbers_raise(text):
+    with pytest.raises(ValueError):
+        normalize_phone(text)
