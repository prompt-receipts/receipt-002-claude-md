@@ -0,0 +1,51 @@
+"""Tests for shop.ext.phones.
+
+Ticket: PAY-4107
+"""
+
+import pytest
+
+from shop.ext.phones import normalize_phone
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2025550123",
+        "(202) 555-0123",
+        "202-555-0123",
+        "202.555.0123",
+        "+1 202 555 0123",
+        "1-202-555-0123",
+        "12025550123",
+        " 1 (202) 555-0123 ",
+    ],
+)
+def test_normalizes_valid_numbers(text):
+    assert normalize_phone(text) == "+12025550123"
+
+
+def test_does_not_validate_area_code():
+    assert normalize_phone("0225550123") == "+10225550123"
+
+
+def test_ignores_letters_and_punctuation():
+    assert normalize_phone("call me at 202-555-0123!") == "+12025550123"
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "555-0123",
+        "202555012",
+        "202555012345",
+        "22025550123",
+        "abc",
+        "+44 20 7946 0958",
+        "1 202 555 01234",
+    ],
+)
+def test_rejects_invalid_numbers(text):
+    with pytest.raises(ValueError):
+        normalize_phone(text)
