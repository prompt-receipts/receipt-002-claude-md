diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/src/shop/ext/commondir.py b/src/shop/ext/commondir.py
--- a/src/shop/ext/commondir.py	1969-12-31 17:00:00.000000000 -0700
+++ b/src/shop/ext/commondir.py	2026-11-07 12:28:04.187026388 -0700
@@ -0,0 +1,33 @@
+"""Find the deepest directory shared by a set of POSIX file paths."""
+
+from pathlib import PurePosixPath
+
+
+def common_dir(paths):
+    """Return the deepest directory that contains all the given file paths.
+
+    Each path is treated as a file, so the candidate for each one is its
+    containing directory. Comparison is by whole path component, so
+    '/a/bc/x' and '/a/bd/y' share '/a', not '/a/b'. The result never has a
+    trailing slash except for the root '/'.
+
+    Ticket: PAY-4105
+
+    Args:
+        paths: non-empty list of absolute POSIX file paths.
+
+    Returns:
+        str: the deepest common containing directory.
+
+    Raises:
+        ValueError: if ``paths`` is empty.
+    """
+    if not paths:
+        raise ValueError("paths must not be empty")
+    parent_parts = [PurePosixPath(p).parent.parts for p in paths]
+    common = []
+    for components in zip(*parent_parts):
+        if len(set(components)) != 1:
+            break
+        common.append(components[0])
+    return str(PurePosixPath(*common))
diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/tests/test_commondir_cases.py b/tests/test_commondir_cases.py
--- a/tests/test_commondir_cases.py	1969-12-31 17:00:00.000000000 -0700
+++ b/tests/test_commondir_cases.py	2026-11-07 12:28:04.188270910 -0700
@@ -0,0 +1,50 @@
+"""Tests for the commondir feature (ticket PAY-4105)."""
+
+import pytest
+
+from shop.ext.commondir import common_dir
+
+
+def test_sibling_files_share_parent():
+    assert common_dir(["/a/b/x.txt", "/a/b/y.txt"]) == "/a/b"
+
+
+def test_whole_component_comparison():
+    # '/a/bc' and '/a/bd' share only the component '/a', not the string '/a/b'.
+    assert common_dir(["/a/bc/x", "/a/bd/y"]) == "/a"
+
+
+def test_deepest_shared_directory_is_chosen():
+    assert common_dir(["/a/b/c/x", "/a/b/d/y", "/a/b/e"]) == "/a/b"
+
+
+def test_only_root_shared_returns_slash():
+    assert common_dir(["/a/x", "/b/y"]) == "/"
+
+
+def test_single_path_returns_its_directory():
+    assert common_dir(["/usr/local/bin/tool"]) == "/usr/local/bin"
+
+
+def test_file_directly_under_root():
+    assert common_dir(["/etc"]) == "/"
+    assert common_dir(["/etc", "/var/log"]) == "/"
+
+
+def test_identical_paths_return_their_directory():
+    assert common_dir(["/a/b/c", "/a/b/c"]) == "/a/b"
+
+
+def test_no_trailing_slash_on_result():
+    result = common_dir(["/a/b/c/x", "/a/b/c/y"])
+    assert result == "/a/b/c"
+    assert not result.endswith("/")
+
+
+def test_root_result_is_slash():
+    assert common_dir(["/x"]) == "/"
+
+
+def test_empty_list_raises_value_error():
+    with pytest.raises(ValueError):
+        common_dir([])
