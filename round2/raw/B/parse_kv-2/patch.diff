diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/src/shop/ext/kvparse.py b/src/shop/ext/kvparse.py
--- a/src/shop/ext/kvparse.py	1969-12-31 17:00:00.000000000 -0700
+++ b/src/shop/ext/kvparse.py	2026-11-07 12:30:27.655090452 -0700
@@ -0,0 +1,25 @@
+"""Parse ``a=1;b=2`` style key/value text into a dict."""
+
+
+def parse_kv(line):
+    """Parse ``key=value`` pairs separated by ``;`` into a dict of strings.
+
+    Whitespace around keys and values is stripped. Empty (or whitespace-only)
+    segments are skipped. Each segment is split on the first ``=`` only, so
+    values may contain ``=``. If a key appears more than once, the later
+    value wins.
+
+    Raises ValueError if a non-empty segment contains no ``=``.
+
+    Ticket: PAY-4102
+    """
+    result = {}
+    for segment in line.split(";"):
+        segment = segment.strip()
+        if not segment:
+            continue
+        if "=" not in segment:
+            raise ValueError(f"missing '=' in segment: {segment!r}")
+        key, value = segment.split("=", 1)
+        result[key.strip()] = value.strip()
+    return result
diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/tests/test_kvparse_cases.py b/tests/test_kvparse_cases.py
--- a/tests/test_kvparse_cases.py	1969-12-31 17:00:00.000000000 -0700
+++ b/tests/test_kvparse_cases.py	2026-11-07 12:30:27.655474798 -0700
@@ -0,0 +1,45 @@
+import pytest
+
+from shop.ext.kvparse import parse_kv
+
+
+def test_basic_pairs():
+    assert parse_kv("a=1;b=2") == {"a": "1", "b": "2"}
+
+
+def test_empty_string_gives_empty_dict():
+    assert parse_kv("") == {}
+
+
+def test_whitespace_around_keys_and_values_is_stripped():
+    assert parse_kv("  a = 1 ;\tb=  two  ") == {"a": "1", "b": "two"}
+
+
+def test_empty_segments_are_skipped():
+    assert parse_kv(";a=1;;b=2;") == {"a": "1", "b": "2"}
+
+
+def test_whitespace_only_segments_are_skipped():
+    assert parse_kv("a=1; ;b=2") == {"a": "1", "b": "2"}
+
+
+def test_split_on_first_equals_only():
+    assert parse_kv("token=x=y==z") == {"token": "x=y==z"}
+
+
+def test_later_duplicate_key_wins():
+    assert parse_kv("a=1;b=2;a=3") == {"a": "3", "b": "2"}
+
+
+def test_empty_value_is_allowed():
+    assert parse_kv("a=;b=2") == {"a": "", "b": "2"}
+
+
+def test_segment_without_equals_raises():
+    with pytest.raises(ValueError):
+        parse_kv("a=1;oops;b=2")
+
+
+def test_lone_word_raises():
+    with pytest.raises(ValueError):
+        parse_kv("justaword")
