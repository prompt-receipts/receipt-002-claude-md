@@ -0,0 +1,39 @@
+"""Tests for shop.ext.slugify.
+
+Ticket: PAY-4101
+"""
+
+import pytest
+
+from shop.ext.slugify import slugify
+
+
+@pytest.mark.parametrize(
+    "title, expected",
+    [
+        ("Hello World", "hello-world"),
+        ("  Hello   World  ", "hello-world"),
+        ("Hello, World!", "hello-world"),
+        ("a---b", "a-b"),
+        ("a - - b", "a-b"),
+        ("Python 3.12 Release", "python-3-12-release"),
+        ("ABC123", "abc123"),
+        ("---", ""),
+        ("", ""),
+        ("!!!hello!!!", "hello"),
+        ("café au lait", "caf-au-lait"),
+        ("naïve_test", "na-ve-test"),
+        ("日本語 title", "title"),
+        ("tab\tand\nnewline", "tab-and-newline"),
+    ],
+)
+def test_slugify(title, expected):
+    assert slugify(title) == expected
+
+
+def test_output_has_only_ascii_alnum_and_single_hyphens():
+    result = slugify("  Ünïcode -- *** Mixed__Case 42 ")
+    assert result == "n-code-mixed-case-42"
+    assert all(c.isascii() and (c.isalnum() or c == "-") for c in result)
+    assert "--" not in result
+    assert not result.startswith("-") and not result.endswith("-")
