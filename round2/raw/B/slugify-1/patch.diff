diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/src/shop/ext/slugify.py b/src/shop/ext/slugify.py
--- a/src/shop/ext/slugify.py	1969-12-31 17:00:00.000000000 -0700
+++ b/src/shop/ext/slugify.py	2026-11-07 12:41:38.233226751 -0700
@@ -0,0 +1,22 @@
+"""URL-friendly slug generation."""
+
+
+def slugify(title):
+    """Convert a title into a lowercase, hyphen-separated slug.
+
+    The text is lowercased, every run of characters that are not ASCII
+    letters or digits is replaced with a single '-', and leading and
+    trailing '-' are stripped.
+
+    Ticket: PAY-4101
+    """
+    parts = []
+    in_separator = False
+    for ch in title.lower():
+        if ch.isascii() and ch.isalnum():
+            parts.append(ch)
+            in_separator = False
+        elif not in_separator:
+            parts.append("-")
+            in_separator = True
+    return "".join(parts).strip("-")
diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' a/tests/test_slugify_cases.py b/tests/test_slugify_cases.py
--- a/tests/test_slugify_cases.py	1969-12-31 17:00:00.000000000 -0700
